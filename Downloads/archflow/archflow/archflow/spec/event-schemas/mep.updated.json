{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "zone_id": {"type": "string"},
    "routes": {"type": "array", "items": {"type": "object"}},
    "clash_count": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"}
