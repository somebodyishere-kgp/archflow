{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TwinGraph Node",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "runtime_cycle_id": {
      "type": ["string", "null"]
    },
    "entity_type": {
      "type": "string"
    },
    "entity_properties": {
      "type": "object",
      "additionalProperties": true
    },
    "system_domain": {
      "type": "string"
    },
    "semantic_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "urban_context_id": {
      "type": ["string", "null"]
    },
    "zoning_classification": {
      "type": ["string", "null"]
    },
    "mobility_graph_links": {
      "type": "array",
      "items": { "type": "string" }
    },
    "public_realm_score": {
      "type": ["number", "null"]
    },
    "geometry": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "solid",
            "surface",
            "void"
          ]
        },
        "wkb": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "wkb"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "material_layers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "thermal_r": {
          "type": "number"
        },
        "fire_rating": {
          "type": "string"
        },
        "acoustic_rating": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string"
          },
          "relation_type": {
            "type": "string"
          }
        },
        "required": [
          "target_id",
          "relation_type"
        ],
        "additionalProperties": true
      }
    },
    "version": {
      "type": "string",
      "format": "date-time"
    },
    "compliance_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "execution_metadata": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": ["string", "null"]
        },
        "execution_id": {
          "type": ["string", "null"]
        },
        "intent_source": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "hierarchy": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["city", "district", "block", "parcel", "building", "space"]
        }
      },
      "required": ["level"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "project_id",
    "context_id",
    "entity_type",
    "system_domain",
    "type",
    "geometry"
  ],
  "additionalProperties": false
}
