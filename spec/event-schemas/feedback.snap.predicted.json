{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feedback.snap.predicted",
  "type": "object",
  "required": ["event_name", "workspace_id", "anchor_id", "mode", "distance", "timestamp"],
  "properties": {
    "event_name": { "const": "feedback.snap.predicted" },
    "workspace_id": { "type": "string", "minLength": 1 },
    "anchor_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["grid", "axis", "assembly-anchor", "parametric-guide"] },
    "distance": { "type": "number", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
