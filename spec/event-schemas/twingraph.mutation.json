{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mutation_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "operation": {
      "type": "string",
      "enum": ["create", "update", "delete"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["mutation_id", "node_id", "operation", "timestamp"],
  "additionalProperties": false
}
